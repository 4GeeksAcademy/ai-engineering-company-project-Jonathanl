# Copy to repository root as .env and replace all placeholders locally.
# Never use this template as a production secret store.
SECRET_KEY=replace-with-a-random-secret-generated-locally
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# Required by the current API startup; use your own PostgreSQL/Supabase URL.
DATABASE_URL=

# Optional transactional email. Keep empty unless securely configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:3000

# Internal Docker networking / local development.
BACKEND_URL=http://backend:8000
BACKOFFICE_BACKEND_PROXY_PATH=/backend
WATCHPACK_POLLING=true
